rules_version = '2';

// FARMAPS - Reglas de seguridad de Cloud Firestore
// - Lectura pública solo para el catálogo (farmacias, medicamentos, presentaciones, ofertas).
// - Escritura solo para administradores registrados en /administradores/{uid}.
// - Se validan campos, tipos, rangos y referencias. No se permiten eliminaciones.
service cloud.firestore {
  match /databases/{database}/documents {

    function ruta(coleccion, id) {
      return /databases/$(database)/documents/$(coleccion)/$(id);
    }

    function esAdmin() {
      return request.auth != null && exists(ruta('administradores', request.auth.uid));
    }

    function d() {
      return request.resource.data;
    }

    function textoValido(v) {
      return v is string && v.trim().size() > 0 && v.size() <= 300;
    }

    function responsableValido() {
      return d().actualizadoPor == request.auth.uid;
    }

    // RI-09: los datos simulados se identifican; los reales exigen fuente.
    function origenValido() {
      return (d().tipoDato == 'simulado' && (!('fuente' in d()) || d().fuente is string))
          || (d().tipoDato == 'real' && textoValido(d().fuente));
    }

    function farmaciaValida() {
      return d().keys().hasAll(['nombre', 'direccion', 'latitud', 'longitud', 'tipoDato', 'actualizadoPor'])
          && d().keys().hasOnly(['nombre', 'direccion', 'latitud', 'longitud', 'horario', 'tipoDato', 'fuente', 'actualizadoPor'])
          && textoValido(d().nombre)
          && textoValido(d().direccion)
          && d().latitud is number && d().latitud >= -90 && d().latitud <= 90
          && d().longitud is number && d().longitud >= -180 && d().longitud <= 180
          && (!('horario' in d()) || d().horario is string)
          && origenValido()
          && responsableValido();
    }

    function medicamentoValido() {
      return d().keys().hasAll(['nombreComercial', 'principioActivo', 'tipoDato', 'actualizadoPor'])
          && d().keys().hasOnly(['nombreComercial', 'principioActivo', 'tipoDato', 'fuente', 'actualizadoPor'])
          && textoValido(d().nombreComercial)
          && textoValido(d().principioActivo)
          && origenValido()
          && responsableValido();
    }

    // RI-02: la presentación referencia un medicamento existente (o creado en el mismo lote).
    function presentacionValida() {
      return d().keys().hasAll(['medicamentoId', 'concentracion', 'formaFarmaceutica', 'contenidoEnvase', 'actualizadoPor'])
          && d().keys().hasOnly(['medicamentoId', 'concentracion', 'formaFarmaceutica', 'contenidoEnvase', 'actualizadoPor'])
          && textoValido(d().medicamentoId)
          && textoValido(d().concentracion)
          && textoValido(d().formaFarmaceutica)
          && textoValido(d().contenidoEnvase)
          && existsAfter(ruta('medicamentos', d().medicamentoId))
          && responsableValido();
    }

    // RI-09: una oferta real solo puede basarse en farmacia y medicamento reales.
    function ofertaCoherente() {
      return d().tipoDato == 'simulado'
          || (get(ruta('farmacias', d().farmaciaId)).data.tipoDato == 'real'
              && get(ruta('medicamentos', get(ruta('presentaciones', d().presentacionId)).data.medicamentoId)).data.tipoDato == 'real');
    }

    // RI-04, RI-07, RI-08, RI-13
    function ofertaValida(ofertaId) {
      return d().keys().hasAll(['farmaciaId', 'presentacionId', 'precio', 'moneda', 'disponibilidadReportada', 'fechaActualizacion', 'tipoDato', 'actualizadoPor'])
          && d().keys().hasOnly(['farmaciaId', 'presentacionId', 'precio', 'moneda', 'disponibilidadReportada', 'fechaActualizacion', 'tipoDato', 'fuente', 'actualizadoPor'])
          && textoValido(d().farmaciaId)
          && textoValido(d().presentacionId)
          && d().precio is number && d().precio > 0 && d().precio < 100000000
          && d().moneda in ['COP']
          && d().disponibilidadReportada is bool
          && d().fechaActualizacion == request.time
          && ofertaId == d().farmaciaId + '__' + d().presentacionId + '__' + d().moneda
          && existsAfter(ruta('farmacias', d().farmaciaId))
          && existsAfter(ruta('presentaciones', d().presentacionId))
          && origenValido()
          && ofertaCoherente()
          && responsableValido();
    }

    match /farmacias/{id} {
      allow read: if true;
      allow create, update: if esAdmin() && farmaciaValida();
      allow delete: if false;
    }

    match /medicamentos/{id} {
      allow read: if true;
      allow create, update: if esAdmin() && medicamentoValido();
      allow delete: if false;
    }

    match /presentaciones/{id} {
      allow read: if true;
      allow create, update: if esAdmin() && presentacionValida();
      allow delete: if false;
    }

    match /ofertas/{ofertaId} {
      allow read: if true;
      allow create, update: if esAdmin() && ofertaValida(ofertaId);
      allow delete: if false;
    }

    // Perfil administrativo: solo su titular puede leerlo; se crea desde la consola de Firebase.
    match /administradores/{uid} {
      allow get: if request.auth != null && request.auth.uid == uid;
      allow list, write: if false;
    }

    // Denegación por defecto: cualquier otra colección queda bloqueada.
  }
}
